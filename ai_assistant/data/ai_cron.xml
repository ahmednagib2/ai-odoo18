<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate='1'>
    <record id='ir_cron_ai_purge' model='ir.cron'>
        <field name='name'>المساعد الذكي: حذف رسائل المحادثات القديمة</field>
        <field name='model_id' ref='model_ai_conversation'/>
        <field name='state'>code</field>
        <field name='code'>model._cron_purge()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>days</field>
        <field name='user_id' ref='base.user_root'/>
        <field name='active' eval='True'/>
    </record>
    <record id='ir_cron_ai_expire_elevated_access' model='ir.cron'>
        <field name='name'>المساعد الذكي: إنهاء الصلاحيات المرتفعة المنتهية</field>
        <field name='model_id' ref='model_ai_elevated_access'/>
        <field name='state'>code</field>
        <field name='code'>model._cron_expire()</field>
        <field name='interval_number'>1</field>
        <field name='interval_type'>hours</field>
        <field name='user_id' ref='base.user_root'/>
        <field name='active' eval='True'/>
    </record>
</odoo>
